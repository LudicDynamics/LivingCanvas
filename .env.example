# Copy to .env.local (git-ignored) and fill in what you have. NEVER commit keys.
# Every variable is explained in guide/configuration.md.
# The server listens on 127.0.0.1 only. Set AIRP_HOST=0.0.0.0 to expose it on your
# network; there is no login in front of it, so only do that on a network you trust.
#
# How this build talks to Worldlines (sign-in on or off, service
# addresses) is set in config/.env.local, not here.

# --- Writer and character agents (any OpenAI-compatible endpoint) -------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Which model the writer and each character use is picked per game in the in-game
# Agents panel (or by the world's own world.json "models").
# Short interactive beats use a low reasoning budget; raise it for slower, deeper turns.
AIRP_WRITER_THINKING=low
# Optional: DeepSeek as an alternative (or the only) provider.
# DEEPSEEK_API_KEY=

# --- The writer's speed switches (optional) -------------------------------------
# One model call per ordinary beat instead of the full agent loop: on (default) | shadow | off.
# AIRP_WRITER_FAST_PATH=on
# AIRP_WRITER_FAST_PATH_MODEL=deepseek-v4-flash

# --- Images (the writer draws missing scene art at play time) ------------------
AIRP_IMAGE_MODEL=openai/gpt-image-1
AIRP_IMAGE_BASE_URL=https://api.openai.com/v1
AIRP_IMAGE_QUALITY=low
AIRP_IMAGE_TIMEOUT_MS=180000

# --- Player voice input (speech-to-text; reuses the OpenAI key above) ----------
# AIRP_STT_MODEL=gpt-4o-transcribe

# --- Character voices (optional; DashScope Qwen-TTS, international region) ------
# DASHSCOPE_API_KEY=
# AIRP_TTS_MODEL=qwen3-tts-flash
# AIRP_TTS_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# AIRP_TTS_DEFAULT_VOICE=Cherry
# A local TTS server of your own: POST <base>/v1/tts returns WAV.
# AIRP_TTS_LOCAL_BASE_URL=
# AIRP_TTS_LOCAL_VOICE=

# Inactivity budget for one agent turn; text and tool progress refresh it.
AIRP_TURN_TIMEOUT_MS=240000

# For a custom gateway, configure its provider and models in .pi/agent/models.json.
# Its apiKey may reference OPENAI_API_KEY, DEEPSEEK_API_KEY or OPENROUTER_API_KEY;
# other variables are withheld from the agents (see guide/configuration.md).
