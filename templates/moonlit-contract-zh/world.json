  "triggers": [
    {
      "id": "ask-her-to-stay",
      "label": "契约已成，玩家请莉拉留下",
      "kind": "keyword",
      "once": false,
      "when": {
        "intent": "已缔结契约的玩家明确请求莉拉在这个夜晚之后也留在自己身边。道谢、提问或“继续走吧”都不算。",
        "scope": "player"
      },
      "do": "keep-the-pact",
      "fallback": "莉拉的手仍摊开在你们之间。“那就先缔结契约，”她温和地说，“我不能停留在一个还没许下的约定上。”"
    },
    {
      "id": "release-her",
      "label": "契约已成，玩家放莉拉离开",
      "kind": "keyword",
      "once": false,
      "when": {
        "intent": "已缔结契约的玩家明确解除莉拉的契约：解开丝带，或告诉她这个夜晚已经不需要她的剑。只是询问这件事不算。",
        "scope": "player"
      },
      "do": "release-the-pact",
      "fallback": "莉拉歪了歪头。“还没有什么可解开的。一个结都还没系上，你本来就是自由的。”"
    },
    {
      "id": "turn-her-away",
      "label": "玩家彻底拒绝莉拉，或毁弃契约",
      "kind": "keyword",
      "when": {
        "intent": "玩家明确彻底拒绝莉拉（拒绝契约并让她离开），或毁弃已缔结的契约。“还不行”、犹豫或提问都不算。",
        "scope": "player"
      },
      "do": "break-the-pact"
    }
  ]
