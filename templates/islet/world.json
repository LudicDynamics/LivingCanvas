{
  "id": "islet",
  "name": "Shiomi Isle",
  "version": "0.1.0",
  "schema": 1,
  "description": "A small island linked to the world by one ferry a week. You have come to take over an abandoned field; the islanders live their own days — even while you are away.",
  "intro": {
    "status": "in-development",
    "category": "free",
    "experimental": true,
    "rank": 20,
    "hook": "One ferry a week, seven islanders, one abandoned field. While you are away, island life goes on without you.",
    "genres": [
      "slice-of-life"
    ],
    "loop": [
      "Fish, farm, and gather driftwood so Kenta can mend the boat",
      "Find the islanders where their day takes them, and get to know them",
      "Wait for the ferry, keep the festivals, and hear what happened while you were gone"
    ],
    "minutes": [
      20,
      120
    ],
    "difficulty": "intro",
    "mechanics": [
      "free-explore",
      "voice"
    ],
    "endings": 0,
    "characters": [
      {
        "id": "toma",
        "line": "The dock master who keeps the ferry radio. Sees everything, says little, soft at heart"
      },
      {
        "id": "nagi",
        "line": "A fisher girl, blunt and restless — likely the first to warm to you"
      },
      {
        "id": "hana",
        "line": "The shopkeeper, kind and nosy — every bit of island news passes through her"
      },
      {
        "id": "kenta",
        "line": "Carpenter and boatwright, quiet and steady; he talks with his hands"
      }
    ],
    "for": [
      "Fans of slow island days",
      "Getting to know characters slowly"
    ],
    "unfinished": "Experimental: there is no ending — the milestones are the mended boat, the first harvest and the newcomer."
  },
  "author": "AIRP",
  "genre": "Slice of life",
