  "triggers": [
    {
      "id": "first-harvest",
      "label": "The first harvest",
      "kind": "state",
      "when": "world.farm_growth >= 4",
      "do": "first-harvest"
    },
    {
      "id": "harvest",
      "label": "Harvest",
      "kind": "state",
      "when": "world.farm_growth >= 4",
      "once": false,
      "do": "harvest"
    },
    {
      "id": "boat-mended",
      "label": "The mended boat goes in the water",
      "kind": "state",
      "when": "world.boat_progress >= 3",
      "do": "boat-mended"
    },
    {
      "id": "kai-arrives",
      "label": "The ferry brings a newcomer",
      "kind": "state",
      "when": "events.ferry == true && time.day >= 8 || time.day >= 9",
      "do": "kai-arrives"
    },
    {
      "id": "ferry-horn",
      "label": "Ferry day",
      "kind": "state",
      "when": "events.ferry == true",
      "once": false,
      "fallback": "A horn sounds across the water — the weekly ferry noses up to the pier. Toma raises a hand to the boat."
    },
    {
      "id": "storm-day",
      "label": "Storm",
      "kind": "state",
      "when": "time.weather == \"storm\"",
      "once": false,
      "fallback": "The sky goes dark all at once and waves slap the pier. Grandma Suzu said the wind would rise today. No boat will sail in this."
    },
    {
      "id": "spring-tide",
      "label": "Spring Tide Shell Day",
      "kind": "state",
      "when": "events.spring_tide == true",
      "once": false,
      "fallback": "The spring tide has drawn far out, baring the whole flat. Everyone on the island has come to the beach with a bucket — it is Shell Day."
    },
    {
