{
  "by": "xia-cheng",
  "gap": 3,
  "hints": [
    {
      "id": "lt-notebook",
      "when": {
        "layer": "world/seated-car",
        "has": [
          "world/seated-car/su-he-notebook.md"
        ],
        "lacks": [
          "player/su-he-notebook.md"
        ],
        "idle": 1
      },
      "say": "Her notebook's still lying open on seat 17… take a look?",
      "suggest": [
        {
          "card": "world/seated-car/README.md",
          "option": "take-notebook"
        }
      ],
      "replies": [
        "Is this her notebook?"
      ],
      "priority": 80
    },
    {
      "id": "lt-ask",
      "when": {
        "layer": "world/seated-car",
        "has": [
          "player/su-he-notebook.md"
        ],
        "lacks": [
          "world/seated-car/witness-account.md",
          "world/seated-car/witness-half.md",
          "player/witness-account.md",
          "player/witness-half.md"
        ],
        "idle": 1
      },
      "say": "That student in seat 20 doesn't look like he's slept at all — ask him what he saw?",
      "suggest": [
        {
          "card": "world/seated-car/README.md",
          "option": "search"
        }
      ],
      "replies": [
        "He's been awake the whole time?"
      ],
      "priority": 70
    },
    {
      "id": "lt-coat",
      "when": {
        "expr": "has(\"world/seated-car/witness-account.md\") || has(\"player/witness-account.md\")",
        "unvisited": "world/sleeper"
      },
      "say": "A grey wool coat… I think one's hanging by compartment 3 in the sleeper.",
      "suggest": [
        {
          "card": "world/seated-car/README.md",
          "option": "go-sleeper"
        },
        {
          "enter": "world/sleeper",
          "label": "Go to the sleeper at the rear (Car 3)"
        }
      ],
      "replies": [
        "A grey coat… have you seen anyone wear one?"
      ],
      "priority": 75
    },
    {
      "id": "lt-coat-half",
      "when": {
        "expr": "has(\"world/seated-car/witness-half.md\") || has(\"player/witness-half.md\")",
        "lacks": [
          "world/seated-car/witness-account.md",
          "player/witness-account.md"
        ],
        "unvisited": "world/sleeper"
      },
      "say": "Someone helped her toward the rear… the first car that way is the sleeper.",
      "suggest": [
        {
          "card": "world/seated-car/README.md",
          "option": "go-sleeper"
        },
        {
          "enter": "world/sleeper",
          "label": "Go to the sleeper at the rear (Car 3)"
        }
      ],
      "priority": 74
    },
    {
      "id": "lt-move-on",
      "when": {
        "layer": "world/seated-car",
        "expr": "world.turns >= 4",
        "idle": 1,
        "unvisited": "world/sleeper"
      },
      "say": "I think this car's done for now. The sleeper's toward the back, or we could look at the whole train?",
      "suggest": [
        {
          "card": "world/seated-car/README.md",
          "option": "go-sleeper"
        },
        {
          "card": "world/seated-car/README.md",
          "option": "go-train"
        }
      ],
      "priority": 45
    },
    {
      "id": "lt-overview",
      "when": {
        "layer": "map"
      },
      "say": "Past one already, and the train leaves at five. Sleeper, dining car, cab — where first?",
      "replies": [
        "Where is the key usually kept?"
      ],
      "priority": 60,
      "inspire": {
        "vague": "Three cars, and something wrong in each of them."
      }
    },
    {
      "id": "lt-coat-look",
      "when": {
        "layer": "world/sleeper",
        "idle": 1
      },
      "say": "That coat by the door… take a closer look at the hem?",
      "suggest": [
        {
          "card": "world/sleeper/README.md",
          "option": "read-coat"
        }
      ],
      "replies": [
        "Whose coat is this?"
      ],
      "priority": 55
    },
    {
      "id": "lt-sleeper-search",
      "when": {
        "layer": "world/sleeper",
        "lacks": [
          "world/sleeper/pill-strip.md",
          "player/pill-strip.md",
          "world/sleeper/pill-strip-half.md"
        ],
        "idle": 3
      },
      "say": "He's lying with his back to the door… while he sleeps, a look under his pillow?",
      "suggest": [
        {
          "card": "world/sleeper/README.md",
          "option": "search"
        }
      ],
      "priority": 50,
      "inspire": {
        "vague": "Mr Zhong sleeps so soundly… does he?",
        "sharp": "Still, back to the door, but not a sleeper's breathing. Something is under his pillow — search the compartment now."
      }
    },
    {
      "id": "lt-pills-long",
      "when": {
        "layer": "world/sleeper",
        "has": [
          "world/sleeper/pill-strip-half.md"
        ],
        "lacks": [
          "player/pill-strip.md",
          "world/sleeper/pill-strip.md"
        ],
        "idle": 1
      },
      "say": "I'll call him out for a ticket check and keep him busy — you check under the pillow.",
      "suggest": [
        {
          "card": "world/sleeper/05-long-way.md",
          "option": "long-way"
        }
      ],
      "priority": 65
    },
    {
      "id": "lt-pill-take",
      "when": {
        "has": [
          "world/sleeper/pill-strip.md"
        ],
        "lacks": [
          "player/pill-strip.md"
        ]
      },
      "say": "Keep that strip. Two missing — and he says he slept like a log.",
      "suggest": [
        {
          "card": "world/sleeper/search-scene.md",
          "option": "collect-reward-0"
        }
      ],
      "priority": 88
    },
    {
      "id": "lt-bill-1",
      "group": "bill",
      "level": 1,
      "when": {
        "layer": "world/dining-car",
        "lacks": [
          "player/tea-bill.md"
        ],
        "idle": 1
      },
      "say": "Table 4 hasn't been cleared yet.",
      "replies": [
        "Who used those two cups?"
      ],
      "priority": 55
    },
    {
      "id": "lt-bill-2",
      "group": "bill",
      "level": 2,
      "when": {
        "layer": "world/dining-car",
        "lacks": [
          "player/tea-bill.md"
        ],
        "idle": 3
      },
      "say": "That receipt under the edge of the table… whose tab is it on?",
      "priority": 56
    },
    {
      "id": "lt-bill-3",
      "group": "bill",
      "level": 3,
      "when": {
        "layer": "world/dining-car",
        "lacks": [
          "player/tea-bill.md"
        ],
        "idle": 5
      },
      "say": "Take that receipt. Dispatch will want proof.",
      "suggest": [
        {
          "card": "world/dining-car/README.md",
          "option": "take-bill"
        }
      ],
      "priority": 57
    },
    {
      "id": "lt-key-search",
      "when": {
        "layer": "world/dining-car",
        "lacks": [
          "world/dining-car/freight-key.md",
          "player/freight-key.md",
          "world/dining-car/freight-key-half.md"
        ],
        "idle": 2,
        "visited": "world/cab"
      },
      "say": "The baggage car key isn't in the cab… could someone have dumped it in this car?",
      "suggest": [
        {
          "card": "world/dining-car/README.md",
          "option": "search"
        }
      ],
      "priority": 52,
      "inspire": {
        "vague": "A key nobody should see — where would you throw it?",
        "sharp": "If someone dumped the key in a hurry, the least likely place in the dining car is the coal hopper by the water boiler. Search with the dice."
      }
    },
    {
      "id": "lt-key-search-fresh",
      "when": {
        "layer": "world/dining-car",
        "lacks": [
          "world/dining-car/freight-key.md",
          "player/freight-key.md",
          "world/dining-car/freight-key-half.md"
        ],
        "idle": 2,
        "unvisited": "world/cab"
      },
      "say": "The car 5 key usually hangs in the cab. If someone took it… could they have dumped it in this car?",
      "suggest": [
        {
          "card": "world/dining-car/README.md",
          "option": "search"
        }
      ],
      "priority": 52,
      "inspire": {
        "vague": "A key nobody should see — where would you throw it?",
        "sharp": "If someone dumped the key in a hurry, the least likely place in the dining car is the coal hopper by the water boiler. Search with the dice."
      }
    },
    {
      "id": "lt-key-miss",
      "when": {
        "layer": "world/dining-car",
        "expr": "clock.left >= 2",
        "has": [
          "world/dining-car/freight-key-half.md"
        ],
        "lacks": [
          "player/freight-key.md",
          "world/dining-car/freight-key.md"
        ],
        "idle": 1
      },
      "say": "The coal scuttle… why don't we ask Old He to help tip it out?",
      "suggest": [
        {
          "card": "world/dining-car/05-long-way.md",
          "option": "long-way"
        }
      ],
      "priority": 65
    },
    {
      "id": "lt-key-miss-late",
      "when": {
        "layer": "world/dining-car",
        "expr": "clock.left <= 1",
        "has": [
          "world/dining-car/freight-key-half.md"
        ],
        "lacks": [
          "player/freight-key.md",
          "world/dining-car/freight-key.md"
        ],
        "idle": 1
      },
      "say": "Tipping out the coal scuttle would take a good while… and five o'clock is almost here. We'd never make it to the baggage car after.",
      "priority": 65
    },
    {
      "id": "lt-key-take",
      "when": {
        "has": [
          "world/dining-car/freight-key.md"
        ],
        "lacks": [
          "player/freight-key.md"
        ]
      },
      "say": "The key! Keep it on you — don't let anyone take it again.",
      "suggest": [
        {
          "card": "world/dining-car/search-scene.md",
          "option": "collect-reward-0"
        }
      ],
      "priority": 90
    },
    {
      "id": "lt-key",
      "when": {
        "has": [
          "player/freight-key.md"
        ],
        "unvisited": "world/freight-car"
      },
      "say": "That's the Car 5 key! The baggage car is always locked — could she be in there?",
      "suggest": [
        {
          "enter": "world/freight-car",
          "label": "Go to Car 5, the baggage car"
        }
      ],
      "replies": [
        "The baggage car is usually locked?"
      ],
      "priority": 85
    },
    {
      "id": "lt-late-key",
      "when": {
        "expr": "clock.left <= 3",
        "has": [
          "player/freight-key.md"
        ],
        "unvisited": "world/freight-car"
      },
      "say": "It's nearly half past three. Car 5 first; the rest can wait.",
      "suggest": [
        {
          "enter": "world/freight-car",
          "label": "Go to Car 5, the baggage car"
        }
      ],
      "priority": 95
    },
    {
      "id": "lt-late-nokey",
      "when": {
        "expr": "clock.left <= 3",
        "lacks": [
          "player/freight-key.md"
        ],
        "visited": "world/cab"
      },
      "say": "It's nearly half past three. The baggage car key isn't in the cab… look again in the dining car?",
      "suggest": [
        {
          "enter": "world/dining-car",
          "label": "Go to Car 4, the dining car"
        }
      ],
      "priority": 94
    },
    {
      "id": "lt-late-nokey-fresh",
      "when": {
        "expr": "clock.left <= 3",
        "lacks": [
          "player/freight-key.md"
        ],
        "unvisited": "world/cab"
      },
      "say": "It's nearly half past three. The car 5 key usually hangs in the cab — shall we check there first?",
      "suggest": [
        {
          "enter": "world/cab",
          "label": "Go to Car 1, the cab"
        }
      ],
      "priority": 94
    },
    {
      "id": "lt-cab",
      "when": {
        "layer": "world/cab",
        "lacks": [
          "player/su-he-testimony.md"
        ],
        "idle": 1
      },
      "say": "Dispatch only trusts evidence. Where she is, who did it, how we know — we need all three.",
      "priority": 40,
      "inspire": {
        "vague": "Dispatch will ask more than one question.",
        "sharp": "Dispatch wants three things: where Su He is, who did it (the log page, or the pills plus the receipt), and how you know."
      }
    },
    {
      "id": "lt-freight",
      "when": {
        "layer": "world/freight-car",
        "lacks": [
          "player/su-he-testimony.md"
        ]
      },
      "say": "Su He!… Help her up first, hear what she says.",
      "suggest": [
        {
          "card": "world/freight-car/README.md",
          "option": "take-testimony"
        }
      ],
      "replies": [
        "Is she still breathing?"
      ],
      "priority": 90
    },
    {
      "id": "lt-confront",
      "when": {
        "layer": "world/freight-car",
        "has": [
          "player/su-he-testimony.md"
        ],
        "lacks": [
          "world/freight-car/logbook-page.md",
          "player/logbook-page.md",
          "world/freight-car/torn-corner.md",
          "player/torn-corner.md"
        ],
        "idle": 1
      },
      "say": "At the door… it's Zhong Huaili. His hand is on the inside pocket of his coat.",
      "suggest": [
        {
          "card": "world/freight-car/README.md",
          "option": "confront"
        }
      ],
      "priority": 80
    },
    {
      "id": "lt-log-take",
      "when": {
        "has": [
          "world/freight-car/logbook-page.md"
        ],
        "lacks": [
          "player/logbook-page.md"
        ]
      },
      "say": "Keep the log page safe — he's spent twelve years looking for this.",
      "suggest": [
        {
          "card": "world/freight-car/04-confront-dice.md",
          "option": "collect-reward-0"
        }
      ],
      "priority": 92
    },
    {
      "id": "lt-sustain",
      "when": {
        "expr": "has(\"world/freight-car/torn-corner.md\") || has(\"player/torn-corner.md\")",
        "lacks": [
          "player/pill-strip.md"
        ]
      },
      "say": "This scrap alone won't convince dispatch. The pills under his pillow, the receipt from the dining car — we need them too.",
      "priority": 70
    },
    {
      "id": "lt-report-a",
      "when": {
        "has": [
          "player/su-he-testimony.md",
          "player/logbook-page.md"
        ]
      },
      "say": "That's enough. I'll go call Lingkou dispatch from the cab — or will you?",
      "suggest": [
        {
          "card": "world/freight-car/06-radio-relay.md",
          "option": "relay"
        },
        {
          "enter": "world/cab",
          "label": "Use the radio in the cab yourself"
        }
      ],
      "replies": [
        "Let's report it to dispatch."
      ],
      "priority": 98
    },
    {
      "id": "lt-report-b",
      "when": {
        "expr": "has(\"world/freight-car/torn-corner.md\") || has(\"player/torn-corner.md\")",
        "has": [
          "player/su-he-testimony.md",
          "player/pill-strip.md",
          "player/tea-bill.md"
        ],
        "lacks": [
          "player/logbook-page.md"
        ]
      },
      "say": "The pills, the receipt, and her word… that's enough. I'll go call dispatch — or will you?",
      "suggest": [
        {
          "card": "world/freight-car/06-radio-relay.md",
          "option": "relay"
        },
        {
          "enter": "world/cab",
          "label": "Use the radio in the cab yourself"
        }
      ],
      "replies": [
        "Let's report it to dispatch."
      ],
      "priority": 97
    },
    {
      "id": "lt-report-b-away",
      "when": {
        "layer": [
          "map",
          "world/seated-car",
          "world/sleeper",
          "world/dining-car",
          "world/cab"
        ],
        "has": [
          "player/su-he-testimony.md",
          "player/pill-strip.md",
          "player/tea-bill.md"
        ],
        "lacks": [
          "player/logbook-page.md",
          "world/freight-car/torn-corner.md",
          "player/torn-corner.md"
        ]
      },
      "say": "The pills, the receipt, and her word… that's enough. I'll go call dispatch — or will you?",
      "suggest": [
        {
          "card": "world/freight-car/06-radio-relay.md",
          "option": "relay"
        },
        {
          "enter": "world/cab",
          "label": "Use the radio in the cab yourself"
        }
      ],
      "replies": [
        "Let's report it to dispatch."
      ],
      "priority": 97
    }
  ]
}
