{
  "id": "islet-jp",
  "name": "潮見島",
  "version": "0.1.0",
  "schema": 1,
  "description": "週に一度の渡し船だけで外とつながる小さな島。荒れた畑を継ぎに越してきたあなたの知らないところでも、島の人たちはそれぞれの日々を過ごしている。",
  "intro": {
    "status": "in-development",
    "category": "free",
    "experimental": true,
    "rank": 20,
    "hook": "週に一便の渡し船、七人の島民、荒れた畑がひとつ。あなたがいない間も、島の日々は進んでいく。",
    "genres": [
      "slice-of-life"
    ],
    "loop": [
      "釣り、畑仕事、流木拾いで健太の船の修理を手伝う",
      "島民の一日を追いかけて会いに行き、少しずつ仲良くなる",
      "渡し船を待ち、祭りを過ごし、留守の間の出来事を聞く"
    ],
    "minutes": [
      20,
      120
    ],
    "difficulty": "intro",
    "mechanics": [
      "free-explore",
      "voice"
    ],
    "endings": 0,
    "characters": [
      {
        "id": "toma",
        "line": "渡し船の無線を預かる桟橋の主。何でも見ていて、口数は少なく、情に厚い"
      },
      {
        "id": "nagi",
        "line": "漁師の娘。口は悪いがじっとしていられない。たぶん最初に打ち解ける相手"
      },
      {
        "id": "hana",
        "line": "雑貨屋の店主。世話好きで噂好き、島の話はみんな彼女を通る"
      },
      {
        "id": "kenta",
        "line": "大工で船大工。無口で頼れる、手で語る男"
      }
    ],
    "for": [
      "スターデューや『どうぶつの森』のようなのんびりした日々が好き",
      "キャラクターと少しずつ仲良くなりたい"
    ],
    "unfinished": "実験中：エンディングはなく、節目は船の修理、初めての収穫、新しい住人だけ。"
  },
