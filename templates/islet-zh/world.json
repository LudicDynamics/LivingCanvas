{
  "id": "islet-zh",
  "name": "潮见岛",
  "version": "0.1.0",
  "schema": 1,
  "description": "一座只靠每周一班渡轮和外界相连的小岛。你搬来接手一块荒了的田；岛民各过各的日子，你不在的时候也一样。",
  "intro": {
    "status": "in-development",
    "category": "free",
    "experimental": true,
    "rank": 20,
    "hook": "每周一班渡轮，七位岛民，一块荒了的田。你不在的时候，岛上的日子照样往前走。",
    "genres": [
      "slice-of-life"
    ],
    "loop": [
      "钓鱼、种田、捡漂流木帮健太修船",
      "跟着岛民的日程去找人，慢慢熟起来",
      "等渡轮、过节，看你不在时岛上发生了什么"
    ],
    "minutes": [
      20,
      120
    ],
    "difficulty": "intro",
    "mechanics": [
      "free-explore",
      "voice"
    ],
    "endings": 0,
    "characters": [
      {
        "id": "toma",
        "line": "码头长，渡轮无线电归他管。什么都看在眼里，话少心软"
      },
      {
        "id": "nagi",
        "line": "渔家少女，嘴硬闲不住，多半会第一个跟你混熟"
      },
      {
        "id": "hana",
        "line": "杂货店主，热心又爱打听，全岛的消息都从她这儿过"
      },
      {
        "id": "kenta",
        "line": "木匠兼船匠，沉默可靠，只用手说话"
      }
    ],
    "for": [
      "喜欢星露谷、动森那种慢日子",
      "想和角色慢慢熟起来"
    ],
    "unfinished": "实验中：没有结局，里程碑只有修好船、第一次收成和新来的人。"
  },
  "author": "AIRP",
