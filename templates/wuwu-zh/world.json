  "updatedAt": "2026-09-26T00:00:00Z",
  "mysteries": [
    {
      "id": "decoy",
      "question": "7号码头那艘无人船，到底是怎么回事？",
      "hint": "想想货舱里装着什么。",
      "options": [
        {
          "id": "storm",
          "label": "遇上风浪，船员弃船逃生，船自己漂回了港里",
          "tier": "wrong",
          "clues": []
        },
        {
          "id": "decoy",
          "label": "它是故意空着放出来的诱饵，好让所有人都盯着7号码头",
          "tier": "surface",
          "clues": [
            "player/decoy-ship.md"
          ],
          "epilogue": "港务所撤了7号码头的封条。那艘空船被拖进船坞，再也没人把它叫作鬼船。"
        },
        {
          "id": "one-wake",
          "label": "诱饵和隧道是同一个计划：第二道航迹从隧道口出来，正好贴着诱饵船擦过去",
          "tier": "hidden",
          "clues": [
            "player/second-wake.md"
          ],
          "title": "同一道航迹",
          "epilogue": "两道航迹被并排画进了港务所的海图。从那以后，雾坞港每逢起雾都会派人守着旧海关隧道口——诱饵再也骗不走所有人的眼睛。"
        },
        {
          "id": "smugglers",
          "label": "走私贩子被熄灭的灯塔害得触礁，趁夜上了岸",
          "tier": "wrong",
          "clues": []
        }
      ]
    },
    {
      "id": "ledger",
      "question": "是谁为雾里那艘船付的钱？",
      "hint": "那枚舵扣件底下压着什么？",
      "options": [
        {
          "id": "vera",
          "label": "薇拉——那枚扣件是她自己的收藏",
          "tier": "wrong",
          "clues": []
        },
        {
          "id": "lord",
          "label": "领主家——那艘不在船册里的船，记在领主家的账簿上",
          "tier": "surface",
          "clues": [
            "player/ledger-page.md"
          ],
          "epilogue": "领主家的账房被请去港务所问话。他们说那只是一笔“寻常的订货”，可从那以后，镇上没人再信“寻常”这两个字。"
        },
        {
          "id": "harbor-office",
          "label": "港务所——他们想骗一笔保险金",
          "tier": "wrong",
          "clues": []
        }
      ]
    },
    {
      "id": "tunnel",
      "question": "那艘船趁什么时候、从哪里出的港？",
      "hint": "灯塔的日志和隧道口的淤泥。",
      "options": [
        {
          "id": "daylight",
          "label": "大白天从7号码头正大光明开出去的",
          "tier": "wrong",
          "clues": []
        },
        {
          "id": "tunnel",
          "label": "趁灯塔熄灭的十二分钟，从旧海关隧道口出的港",
          "tier": "surface",
          "clues": [
            "player/customs-tunnel.md"
          ],
          "epilogue": "旧海关隧道口被钉上了木栅。老莫说，往后灯塔每熄一次，他都会先朝隧道口看一眼。"
        },
        {
          "id": "drift",
          "label": "船上根本没人，是顺着涨潮漂出去的",
          "tier": "wrong",
          "clues": []
        }
      ]
    },
    {
      "id": "old-mo",
      "question": "老莫那天夜里为什么熄灯？",
      "hint": "问问他自己，也看看他不知道的事。",
      "options": [
        {
          "id": "bribed",
          "label": "他收了领主家的钱，专门替那艘船熄的灯",
          "tier": "wrong",
          "clues": []
        },
        {
          "id": "his-own",
          "label": "熄灯是他自己的缘故，他并不知道有船借着这段黑暗出了港",
          "tier": "surface",
          "clues": [
            "player/customs-tunnel.md",
            "player/customs-tunnel-half.md"
          ],
          "epilogue": "老莫听说那十二分钟被人利用了，一整晚没合眼。第二天，他在日志上添了一行：“灯灭时，留意隧道口。”"
        },
        {
          "id": "no-oil",
          "label": "灯油烧完了，他来不及补",
          "tier": "wrong",
          "clues": []
        }
      ]
    }
  ],
  "reckoning": {
    "epilogues": {
      "all": "四个秘密都摊开了。潮水回涨的时候，雾坞镇已经知道那一夜发生过什么——还有薇拉，她终于肯讲那枚扣件的来历了。",
      "most": "你看清了大半。剩下的那一点，雾坞镇的人各有各的说法；可至少，再没有人把那艘无人船叫作鬼船。",
      "few": "潮水涨回来了，那一夜的事却还有太多没说清。也许下一次起雾的时候，你会再回到7号码头。"
    }
  },
  "view": {
    "default": "map"
  }
}
