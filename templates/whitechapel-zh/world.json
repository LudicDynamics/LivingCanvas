  "mysteries": [
    {
      "id": "culprit",
      "question": "是谁把伊迪丝的小说一件件变成了真事？",
      "hint": "谁的手，先碰到了那些画？",
      "options": [
        {
          "id": "edith",
          "label": "伊迪丝自己——为了让小说出名",
          "tier": "wrong",
          "clues": []
        },
        {
          "id": "wayne",
          "label": "插画师亚瑟·韦恩",
          "tier": "surface",
          "clues": [
            "world/london-map/print-shop/illustration-room/visible-details.md",
            "world/london-map/third-crime-scene/pigment-record.md",
            "world/london-map/print-shop/illustration-room/visible-details-half.md",
            "world/london-map/third-crime-scene/pigment-record-half.md"
          ],
          "epilogue": "韦恩的名字从连载的署名栏里被划掉了。印刷所的人说起他，只记得他袖口上洗不掉的那一抹群青。"
        },
        {
          "id": "unseen",
          "label": "韦恩——报社要撤掉他的插图，他要让全伦敦先看见他的画",
          "tier": "hidden",
          "clues": [
            "world/london-map/print-shop/illustration-room/returned-proofs.md"
          ],
          "title": "退回的校样",
          "epilogue": "那叠被退回的校样被收进了苏格兰场的证物袋。布莱克本主编看着上面自己的批语，第一次在稿子上改了主意：往后的连载，插图照登，也署上画师的名字。"
        },
        {
          "id": "blackburn",
          "label": "布莱克本主编——为了报纸的销量",
          "tier": "wrong",
          "clues": []
        }
      ]
    },
    {
      "id": "order",
      "question": "那三起事件，是照着什么布置出来的？",
      "hint": "比一比签收单上的时间和事发的时间。",
      "options": [
        {
          "id": "reader",
          "label": "照着小说的文字——凶手是一个着了魔的读者",
          "tier": "wrong",
          "clues": []
        },
        {
          "id": "picture",
          "label": "照着插图——画在事件之前就已经交到了印刷所",
          "tier": "surface",
          "clues": [
            "world/london-map/print-shop/receipt.md",
            "world/london-map/morgue/time-record.md",
            "world/london-map/print-shop/receipt-half.md",
            "world/london-map/morgue/time-record-half.md"
          ],
          "epilogue": "《晨报》登了一则更正：连载的插图从此在刊出当天才交稿。排字工汤姆说，这是他见过最慢的一次改规矩，也是最对的一次。"
        },
        {
          "id": "hat",
          "label": "照着韦恩自己的画——现场有小说里从没写过的东西",
          "tier": "hidden",
          "clues": [
            "world/london-map/edith-room/margin-note.md"
          ],
          "title": "小说里没有那顶帽子",
          "epilogue": "伊迪丝把三起事件的原稿和插图摊在一起，用红笔圈出了画里多出来的东西：那顶帽子、那把椅子。她说，她终于能确定那不是她写的故事。"
        },
        {
          "id": "chance",
          "label": "只是巧合",
          "tier": "wrong",
          "clues": []
        }
      ]
    },
    {
      "id": "address",
      "question": "伊迪丝为什么把第四章的地址改成一条不存在的街？",
      "hint": "去地图上找找那条街。",
      "options": [
        {
          "id": "ambush",
          "label": "为了把凶手引到那条街上埋伏起来",
          "tier": "wrong",
          "clues": []
        },
        {
          "id": "test",
          "label": "为了看看谁读到了新地址，又因为找不到那条街而露出马脚",
          "tier": "surface",
          "clues": [
            "world/london-map/edith-room/address-correction.md",
            "world/london-map/unnamed-street/revision-scrap.md",
            "world/london-map/edith-room/address-correction-half.md",
            "world/london-map/unnamed-street/revision-scrap-half.md"
          ],
          "epilogue": "伊迪丝把那条不存在的街写进了第四章的定稿。读者只当它是小说家的想象，只有华生知道，那是她替自己设的一道门闩。"
        },
        {
          "id": "typo",
          "label": "只是笔误",
          "tier": "wrong",
          "clues": []
        }
      ]
    },
    {
      "id": "leak",
      "question": "改过地址的原稿，是怎么到了凶手手里的？",
      "hint": "编辑室的传阅记录上，签着谁的名字？",
      "options": [
        {
          "id": "tom",
          "label": "汤姆排字的时候偷看的",
          "tier": "wrong",
          "clues": []
        },
        {
          "id": "forwarded",
          "label": "布莱克本主编按惯例在8:15把它转给了韦恩",
          "tier": "surface",
          "clues": [
            "world/london-map/print-shop/editor-office/correction-log.md",
            "world/london-map/print-shop/editor-office/correction-log-half.md"
          ],
          "epilogue": "布莱克本改了编辑室的规矩：订正稿只在作者和编辑之间传，谁要看，就在他桌前看。"
        },
        {
          "id": "asked",
          "label": "韦恩一拿到就去打听那条街——假地址当天上午就把他钓了出来",
          "tier": "hidden",
          "clues": [
            "world/london-map/unnamed-street/asked-the-way.md"
          ],
          "title": "打听那条街的人",
          "epilogue": "街角卖地图的老人认出了照片上的人：“就是他，袖口一抹蓝，问了三遍那条街在哪。”伊迪丝的试探，比任何人以为的都更早起了作用。"
        },
        {
          "id": "edith-gave",
          "label": "伊迪丝亲手交给了他",
          "tier": "wrong",
          "clues": []
        }
      ]
    }
  ],
  "reckoning": {
    "epilogues": {
      "all": "四个秘密都摊开了。后来贝克街的人说起那个正午，总会提到那顶小说里没有的帽子——还有伊迪丝，她把第四章写完了，用的是自己的地址。",
      "most": "你看清了大半。剩下的那一点，只有韦恩自己知道；可至少，再没有人把伊迪丝的小说当作犯罪的剧本。",
      "few": "正午过去了，可那三起事件背后还有太多没说清。也许下一次连载刊出的时候，你会再去印刷所看一看。"
    }
  },
