  "triggers": [
    {
      "id": "leave-with-her",
      "label": "玩家决定和艾莉丝一起离开",
      "kind": "keyword",
      "once": false,
      "when": {
        "intent": "玩家明确决定和艾莉丝一起离开这里、不再回来：叫上她，和她一起出发。出门看一圈再回来、提问、“也许吧”都不算。",
        "scope": "player"
      },
      "do": "leave-together",
      "fallback": "艾莉丝看看门，又看回你：“外面是什么我们都还不知道。先去看一次，回来再跟我说。”"
    },
    {
      "id": "say-who-you-are",
      "label": "玩家说出自己是谁",
      "kind": "keyword",
      "once": false,
      "when": {
        "intent": "玩家根据信、电话或门外那个地方真正透露的内容，把自己是谁、或自己是怎么来到这间木屋的，当作自己的结论说出来。猜测、提问、自言自语式的琢磨都不算。",
        "scope": "player"
      },
      "do": "remember-yourself",
      "fallback": "你伸手去够，它却滑走了。你是谁，那扇门还没给你看过。先去门那边看看吧。"
    },
    {
      "id": "stay-here",
      "label": "玩家决定留在木屋里",
      "kind": "keyword",
      "when": {
        "intent": "玩家明确决定留在木屋里：不再开门、不再出去，和艾莉丝一起待在这儿。歇一会儿、犹豫、只是问问都不算。",
        "scope": "player"
      },
      "do": "stay-in-the-cabin"
    }
  ]
