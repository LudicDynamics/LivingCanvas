      "options": [
        {
          "id": "edith",
          "label": "イーディス本人――小説を有名にするため",
          "tier": "wrong",
          "clues": []
        },
        {
          "id": "wayne",
          "label": "挿絵画家アーサー・ウェイン",
          "tier": "surface",
          "clues": [
            "world/london-map/print-shop/illustration-room/visible-details.md",
