  "version": "1.0.0",
  "schema": 1,
  "description": "山里的末班车停在隧道正中间，你旁边17号座的乘客不见了。五分钟的序章：说一句话、拿起一样东西、掷一次骰、推开一扇门。",
  "intro": {
    "status": "playable",
    "category": "trpg",
    "hidden": true,
    "rank": 0,
    "hook": "末班车停在隧道正中间，你旁边17号座的乘客不见了。五分钟，找到她。",
    "genres": [
      "mystery"
    ],
    "loop": [
      "点一下就能回答列车员夏澄",
      "拿起她留下的东西，掷一次骰问问醒着的人",
      "推开车尾那扇门，找到她"
    ],
    "minutes": [
      5,
      10
    ],
    "difficulty": "intro",
    "mechanics": [
      "dice",
      "clock"
    ],
    "endings": 1,
    "characters": [
      {
        "id": "xia-cheng",
        "line": "二十四岁的列车员，是她发现17号座空了"
      }
    ],
    "for": [
      "第一次玩",
      "只有五分钟"
    ]
  },
  "author": "Worldlines Canvas / AIRP",
