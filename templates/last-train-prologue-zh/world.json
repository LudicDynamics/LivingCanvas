  "mode": "closed",
  "clock": {
    "path": "world/departure-clock.md",
    "key": "left",
    "start": 4,
    "label": "距离发车",
    "time": {
      "start": "01:10",
      "end": "05:00"
    }
  },
  "endings": [
    {
      "id": "found-her",
      "title": "找到了她",
      "path": "endings/found-her/README.md"
    }
  ],
  "triggers": [
    {
      "id": "notebook",
      "label": "第一回合之后：17号座上的笔记本",
      "kind": "state",
      "when": "world.turns >= 1",
      "do": "drop-notebook"
    },
    {
      "id": "door",
      "label": "车尾的门",
      "kind": "state",
      "when": "has(\"world/seated-car/witness-account.md\") || has(\"world/seated-car/witness-half.md\") || has(\"player/witness-account.md\") || has(\"player/witness-half.md\") || world.turns >= 8 || clock.left <= 1",
      "do": "open-door"
    },
    {
      "id": "found",
      "label": "走进5车",
      "kind": "place",
      "when": {
        "layer": "world/freight-car"
      },
      "ending": "found-her"
    }
  ],
  "characters": [
    {
      "id": "xia-cheng",
      "name": "夏澄",
      "home": "world/seated-car",
      "role": "companion",
      "description": "这趟末班车的列车员，二十四岁。是她点人数时发现17号座空了。熟悉每一节车厢，但只说自己亲眼看到的事。",
      "avatar": "assets/characters/xia-cheng.webp"
    }
  ],
  "opening": {
    "greeter": "xia-cheng",
    "replies": [
      "我睡着了，什么也没看见",
      "她走之前说了什么吗？",
      "别慌，我帮你找"
    ]
  },
