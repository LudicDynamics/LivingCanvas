  "mysteries": [
    {
      "id": "who",
      "question": "誰が蘇禾を座席から連れ去り、荷物車に閉じ込めたのか？",
      "options": [
        {
          "id": "zhong",
          "label": "3車3号の鐘懐礼",
          "tier": "surface",
          "clues": [
            "world/seated-car/witness-account.md",
            "world/sleeper/pill-strip.md",
            "player/tea-bill.md"
          ],
          "epilogue": "周子航は後に嶺口駅でそのグレーのウールコートを思い出した。彼は言う、あの夜もう一言尋ねていればよかった、と。"
        },
        {
          "id": "driver",
          "label": "運転士・秦じい",
          "tier": "wrong"
        },
        {
          "id": "student",
          "label": "後ろの座席にいた学生・周子航",
          "tier": "wrong"
        },
        {
          "id": "herself",
          "label": "誰もいない——蘇禾は自分で隠れていた",
          "tier": "wrong"
        }
      ]
    },
    {
      "id": "tea",
      "question": "蘇禾はなぜぼんやりと人について車尾へ歩いていったのか？",
      "options": [
        {
          "id": "sleeping-pills",
          "label": "食堂車のあの茶には睡眠薬が入れられていた",
          "tier": "surface",
          "clues": [
            "world/sleeper/pill-strip.md",
            "player/tea-bill.md"
          ],
          "epilogue": "検査結果が出た日、賀じいは4号卓の二つの茶碗のことをもう一度話した。彼は言う、これから誰かの勘定を覚えて茶を奢る時は、必ずもう一度よく見ると。"
        },
        {
          "id": "motion-sick",
          "label": "彼女は本当に車酔いし、風に当たる必要があった",
          "tier": "wrong"
        },
        {
          "id": "willing",
          "label": "彼女は自ら車尾へある人に会いに行った",
          "tier": "wrong"
        }
      ]
    },
    {
      "id": "key",
      "question": "荷物車の鍵はどうやって犯人の手に渡り、その後どこへ行ったのか？",
      "options": [
        {
          "id": "cab-to-coal",
          "label": "運転士が降りて運転室が無人になった隙に鍵板から持ち去り、戻って掛ける勇気がなく食堂車の石炭入れに捨てた",
          "tier": "surface",
          "clues": [
            "player/repair-notice.md",
            "world/dining-car/freight-key.md"
          ],
          "epilogue": "秦じいはそれ以来、鍵板を鉄の戸棚にしまい込んだ。彼は言う、鉄道を分かっている者ほど鍵がどこに掛かっているか知っているし、最も触れてはならない、と。"
        },
        {
          "id": "conductor",
          "label": "車掌の夏澄が彼に貸し、彼は使い終わるとすぐ返した",
          "tier": "wrong"
        },
        {
          "id": "su-he-key",
          "label": "鍵はずっと蘇禾自身が持っていた",
          "tier": "wrong"
        }
      ]
    },
    {
      "id": "motive",
      "question": "彼はなぜ蘇禾を今夜消さねばならなかったのか？",
      "options": [
        {
          "id": "memorial",
          "label": "蘇禾は彼に、事故追悼式で十二年前のことを公衆の面前で認めさせようとしていた",
          "tier": "surface",
          "clues": [
            "player/su-he-notebook.md",
            "player/su-he-testimony.md",
            "world/freight-car/logbook-page.md",
            "world/freight-car/torn-corner.md"
          ],
          "epilogue": "追悼式は予定通り開かれ、ただ壇上に発言者が一人欠けていた。蘇禾は最前列に座り、手に一枚の切符を握りしめていた。"
        },
        {
          "id": "red-light",
          "label": "十二年前の01:12、電話で「赤信号で通せ」と命じたのは彼だった。蘇長庚はそれに従い、その言葉を運転日誌に書き留めていた",
          "tier": "hidden",
          "title": "01:12の赤信号",
          "clues": [
            "world/freight-car/logbook-page.md"
          ],
          "epilogue": "その日誌のページは後に何部もコピーされた。断雲トンネルの記念碑では、蘇長庚の名前の横に小さな一行が加えられた：彼は異議を唱えていた。蘇禾は碑の前で長く立ち尽くし、言った、お父さん、今度は誰かが聞いてくれたよ、と。"
        },
        {
          "id": "money",
          "label": "金のため、蘇禾は彼の収賄の帳簿を握っていた",
          "tier": "wrong"
        },
        {
          "id": "threat",
          "label": "蘇禾が彼を傷つけると脅したので、彼はただ自衛しただけ",
          "tier": "wrong"
        }
      ]
    }
  ],
  "reckoning": {
    "epilogues": {
      "all": "あの夜のすべての環をあなたは見抜いた：一杯の茶、一本の鍵、施錠された扉、そして十二年前のあの一分間。夏澄は後に言った、あの日18号に座っていた人は、列車全体で唯一眠っていなかった人だ、と。",
      "most": "あの夜の出来事を、あなたは大半見抜いた。残りのいくつかの環は、後に嶺口の調査班が少しずつ補ったものだ——だが最初に「17号はどこへ行った」と問いかけたのは、あなただった。",
      "few": "あの夜はトンネルの中の霧のようで、あなたはいくつかの輪郭に触れただけだった。何年も後、あなたは山腹に止まったあの終電を思い出すだろう、17号の座席にあった誰も引き取り手のないコートを思い出すだろう。"
    }
  },
