          "enter": "world/freight-car",
          "label": "5호차 화물차로 간다"
        }
      ],
      "priority": 95
    },
    {
      "id": "lt-late-nokey",
      "when": {
        "expr": "clock.left <= 3",
        "lacks": [
          "player/freight-key.md"
